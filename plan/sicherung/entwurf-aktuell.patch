+elements=[];assert.equal(filter([bad]).length,1,'Unbekannter Befund wird still verworfen');
+console.log('OK Originalfilter: vollstaendig abgeschnitten ausgenommen; sichtbar, doppelt, teilweise sichtbar und unbekannt erhalten. Grenze unveraendert4.5.');
