index 00000000..a46d42fa
--- /dev/null
+++ b/plan/werkzeuge/pruefstand/x_abnahme_hash.js
@@ -0,0 +1,38 @@
+/* Virtuelle Helferaenderung: echte Hashfunktionen, keine Quellenmutation. */
+const fs = require('node:fs'), path = require('node:path'), vm = require('node:vm');
+const assert = require('node:assert/strict');
+const {createHash} = require('node:crypto');
+const repo = path.resolve(__dirname, '../../..');
+const {execFileSync} = require('node:child_process');
+const baseline = process.argv.includes('--gegenprobe') ? '5afdb7cd70f8bc84e117a82fcf3b39838ff0398b' : null;
+function auszug(name, changed) {
+  const source = baseline ? execFileSync('git', ['show', baseline + ':plan/werkzeuge/pruefstand/' + name], {cwd: repo, encoding: 'utf8'}) : fs.readFileSync(path.join(__dirname, name), 'utf8');
+  const start = source.indexOf(name === 'alle_pruefen.js' ? 'const relevant=' : 'const stand=createHash');
+  const end = source.indexOf("const kennung=stand.digest('hex');", start);
+  assert(start >= 0 && end > start, 'Hashblock fehlt: ' + name);
+  const readFileSync = (file, ...args) => {
+    const value = fs.readFileSync(file, ...args);
+    if (!changed || path.basename(file) !== changed) return value;
+    return typeof value === 'string' ? value + '\n// Gegenprobe\n' : Buffer.concat([value, Buffer.from('\n// Gegenprobe\n')]);
+  };
+  const context = {fs: {readFileSync}, path, repo, createHash, __dirname};
+  const code = source.slice(start, end) + "const kennung=stand.digest('hex');";
+  const hash = vm.runInNewContext(code + '\nkennung;', context);
+  if (name !== 'alle_pruefen.js') return {hash};
+  const functionStart = source.indexOf('function quellHash(f){');
+  const functionEnd = source.indexOf('\nfunction stoppen(', functionStart);
+  assert(functionStart >= 0 && functionEnd > functionStart, 'Testhashblock fehlt');
+  return {hash, test: vm.runInNewContext(source.slice(functionStart, functionEnd) + "\nquellHash('t_tagesantworten_sdk.js');", context)};
+}
+const plain = auszug('alle_pruefen.js');
+assert.equal(plain.hash, auszug('abnahme_runde.js').hash, 'Runner muessen gleichen Stand benennen');
+for (const changed of ['diagnose_karten_konflikt.js', 't_tagesantworten_sdk.js']) {
+  const variant = auszug('alle_pruefen.js', changed);
+  assert.notEqual(variant.test, plain.test, 'A16-Testhash ignoriert ' + changed);
+  if (changed === 'diagnose_karten_konflikt.js') {
+    assert.notEqual(variant.hash, plain.hash, 'Quellstand ignoriert Helfer');
+    assert.equal(variant.hash, auszug('abnahme_runde.js', changed).hash);
+  }
+}
+assert.equal(auszug('alle_pruefen.js').hash, plain.hash, 'Probe veraendert Quellen');
+console.log('Hash-Gegenproben gruen: SDK-Helfer und Testtext erkannt; beide Runner gleicher Stand. ' + plain.hash);
diff --git a/plan/werkzeuge/pruefstand/x_nur_betreiber_aufbau.js b/plan/werkzeuge/pruefstand/x_nur_betreiber_aufbau.js
