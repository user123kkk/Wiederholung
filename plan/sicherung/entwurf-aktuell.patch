@@ -0,0 +1,28 @@
+/* Reine Aufbau-Gegenprobe: regulaerer echter Test darf ohne historischen
+   Checkout bis zum Browserstart gelangen. Keine Git-/Servermutation. */
+const fs = require('node:fs'), path = require('node:path'), vm = require('node:vm');
+const assert = require('node:assert/strict');
+const { execFileSync } = require('node:child_process');
+const datei = path.join(__dirname, 't_nur_betreiber.js');
+const quelle = process.argv.includes('--gegenprobe')
+  ? execFileSync('git', ['show', '315bb0e:plan/werkzeuge/pruefstand/t_nur_betreiber.js'], { cwd: path.join(__dirname, '../../..') }).toString()
+  : fs.readFileSync(datei, 'utf8');
+const calls = [], browser = new Error('BROWSER-BEGIN');
+const fakeRequire = name => {
+  if (name === 'node:fs') return { ...fs, existsSync: () => false };
+  if (name === 'node:child_process') return {
+    execFileSync: (...args) => { calls.push(['git', ...args]); throw new Error('Historischer Checkout unzugaenglich'); },
+    spawn: (...args) => { calls.push(['server', ...args]); throw new Error('Unnoetiger historischer Server'); }
+  };
+  if (name === './lib') return { start: async () => { throw browser; } };
+  if (name === './text_lib') return { BETREIBER_UID: 'probe' };
+  return require(name);
+};
+(async () => {
+  let fehler;
+  try { await vm.runInNewContext(quelle, { require: fakeRequire, __dirname, console, process: { argv: [], platform: process.platform }, setTimeout }); }
+  catch (e) { fehler = e; }
+  assert.equal(calls.length, 0, 'Regulaerer Test verlangt historischen Checkout/Server');
+  assert.equal(fehler, browser, 'Regulaerer Test erreichte Browserstart nicht');
+  console.log('OK regulaerer Originaltest erreicht Browserstart ohne historischen Checkout/Server');
+})().catch(e => { console.error(e); process.exitCode = 1; });
