@@ -0,0 +1,26 @@
+/* Diagnose, keine Abnahme: acht abwechselnde Paare des unveraenderten
+   t_bestand_tempo.js (3000 Karten, CPU 4x) am festen Vorstand und Entwurf.
+   Assertions/Grenzen bleiben aktiv. Rot wird gezahlt, niemals umgedeutet. */
+const fs = require('node:fs'), path = require('node:path');
+const { spawnSync, execFileSync } = require('node:child_process');
+const alt = '315bb0e';
+const commit = execFileSync('git', ['rev-parse', alt], { cwd: path.join(__dirname, '../../..') }).toString().trim();
+const datei = path.join(__dirname, 't_bestand_tempo.js');
+const quelle = fs.readFileSync(datei, 'utf8');
+if (!quelle.includes("'637995c:app.js'")) throw new Error('Fester Altstand-Anker fehlt');
+const angepasst = quelle.replace("'637995c:app.js'", JSON.stringify(commit + ':app.js'));
+const modul = `const Module=require('node:module');const m=new Module(${JSON.stringify(datei)},module);m.filename=${JSON.stringify(datei)};m.paths=Module._nodeModulePaths(${JSON.stringify(__dirname)});m._compile(${JSON.stringify(angepasst)},${JSON.stringify(datei)});`;
+const ergebnisse = [];
+console.log('Diagnose: Vorstand ' + commit + '; acht Paare; Original-Assertions; 3000 Karten; CPU 4x');
+for (let i = 1; i <= 8; i++) for (const stand of ['alt', 'neu']) {
+  const env = { ...process.env, PRUEF_KARTEN: '3000' };
+  if (stand === 'alt') env.PRUEF_ALT = '1'; else delete env.PRUEF_ALT;
+  const r = spawnSync(process.execPath, ['--require', path.join(__dirname, 'pruef_cleanup.js'), '-e', modul], { cwd: __dirname, env, encoding: 'utf8', timeout: 600000, windowsHide: true });
+  console.log('\nPAAR ' + i + ' ' + stand + ' EXIT ' + r.status);
+  console.log((r.stdout || '') + (r.stderr || ''));
+  if (r.error || r.signal) throw new Error(r.error?.message || r.signal);
+  ergebnisse.push({ paar: i, stand, code: r.status });
+}
+console.log('Ergebnisse: ' + JSON.stringify(ergebnisse));
+console.log('Keine Abnahmefreigabe aus dieser Diagnose.');
+process.exitCode = ergebnisse.some(r => r.code !== 0) ? 1 : 0;
diff --git a/plan/werkzeuge/pruefstand/x_abnahme_hash.js b/plan/werkzeuge/pruefstand/x_abnahme_hash.js
