+          await c.evaluate(id => window.__PRUEF_SDK.deleteDoc(window.__PRUEF_SDK.doc(window.__PRUEF_DB, 'users/u1/karten/' + id)), id);
+          await fertig(c);
+          await a.waitForFunction(id => window.__PRUEF.karte(id) === null, id);
