+/* Diagnose am Original-Tempotest: Chrome-Trace/CPU-Profil der ersten
+   Bewertung mit 3000 Karten. Originalassertion und CPU 4x bleiben aktiv. */
+const fs = require('node:fs'), path = require('node:path'), os = require('node:os');
+const Module = require('node:module');
+const datei = path.join(__dirname, 't_bestand_tempo.js');
+const out = path.join(os.tmpdir(), 'adrabic-bestand-spur');
+fs.mkdirSync(out, { recursive: true });
+process.env.PRUEF_KARTEN = '3000';
+delete process.env.PRUEF_ALT;
+let quelle = fs.readFileSync(datei, 'utf8');
+const start = "await p.keyboard.press('3'); await p.waitForTimeout(1200);";
+const ende = "console.log('App-Zeiten', JSON.stringify(zeiten));";
+if (!quelle.includes(start) || !quelle.includes(ende)) throw new Error('Messanker fehlen');
+quelle = quelle.replace(start, `
+      const events = [];
+      cdp.on('Tracing.dataCollected', d => events.push(...d.value));
+      const fertig = new Promise(r => cdp.once('Tracing.tracingComplete', r));
+      await cdp.send('Profiler.enable'); await cdp.send('Profiler.start');
+      await cdp.send('Tracing.start', { categories: 'devtools.timeline,disabled-by-default-devtools.timeline', transferMode: 'ReportEvents' });
+      ${start}
+      await cdp.send('Tracing.end'); await fertig;
+      const profil = await cdp.send('Profiler.stop');
+      fs.writeFileSync(${JSON.stringify(out)} + '/trace-' + gef + '-' + i + '.json', JSON.stringify(events));
+      fs.writeFileSync(${JSON.stringify(out)} + '/cpu-' + gef + '-' + i + '.json', JSON.stringify(profil.profile));
+      for (const t of events.filter(e => e.name === 'RunTask' && e.ph === 'X' && e.dur > 50000)) {
+        const kids = events.filter(e => e.ph === 'X' && e.pid === t.pid && e.tid === t.tid && e.ts >= t.ts && e.ts + (e.dur || 0) <= t.ts + t.dur && e !== t && e.dur > 3000);
+        console.log('TRACE ' + Math.round(t.dur / 1000) + ' ms: ' + kids.filter(e => ['FunctionCall','TimerFire','Layout','UpdateLayoutTree','EventDispatch'].includes(e.name)).map(e => e.name + ' ' + Math.round(e.dur/1000) + ' ' + JSON.stringify(e.args)).join(' | '));
+      }
