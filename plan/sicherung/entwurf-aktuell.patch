+/* Unveraenderte Rechts-Abnahme; rote Messstelle fotografieren/vermessen. */
+const fs=require('node:fs'),path=require('node:path'),Module=require('node:module');
+const file=path.join(__dirname,'t_rechtsplan.js');
+let code=fs.readFileSync(file,'utf8');
+const anchor='            assert.deepEqual(sichtbar,[]);';
+if(!code.includes(anchor))throw new Error('Messanker fehlt');
+code=code.replace(anchor,`            if(sichtbar.length){
+              await p.screenshot({path:path.join(repo,'plan/sicherung/tests/abnahme-rechtsplan-820-hell.png')});
+              console.log('MESSSTELLE',JSON.stringify(await p.evaluate(()=>{
+                return [...document.querySelectorAll('a,button')].filter(el=>['Datenschutz','Impressum'].includes(el.textContent.trim())).map(el=>{
+                  const r=el.getBoundingClientRect(),cs=getComputedStyle(el);
+                  return {text:el.textContent,klasse:el.className,imDialog:!!el.closest('#dlg-recht-inhalt'),rect:r.toJSON(),color:cs.color,
+                    schichten:(()=>{const a=[];for(let e=el;e;e=e.parentElement)a.push({tag:e.tagName,klasse:e.className,bg:getComputedStyle(e).backgroundColor,rect:e.getBoundingClientRect().toJSON()});return a;})()};
