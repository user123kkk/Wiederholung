@@ -0,0 +1,39 @@
+/* Offline-Auswertung erhaltener Traces. Keine Browserprüfung, keine Freigabe.
+   Prüft große Layouts gegen die zeitlich enthaltenen click-Handler. */
+const fs = require('node:fs'), path = require('node:path'), assert = require('node:assert/strict');
+const root = path.resolve(__dirname, '../../sicherung/tests');
+const dateien = [
+  ['alter Originaltrace', 'trace-315bb0e-verwalten.json'],
+  ['neuer Originaltrace', 'trace-neu-verwalten.json'],
+  ...['original-1', 'sichtbar', 'original-2', 'neustart-original', 'neustart-getrennt'].map(n => [n, 'text-layout-ursache/' + n + '.json'])
+];
+const rund = n => Math.round(n * 100) / 100;
+for (const [name, file] of dateien) {
+  const input = JSON.parse(fs.readFileSync(path.join(root, file), 'utf8'));
+  const events = Array.isArray(input) ? input : input.events;
+  assert(Array.isArray(events), 'Traceereignisse fehlen: ' + file);
+  const marken = events.filter(e => e.name === 'S:Verwalten' || e.name === 'S:Text oeffnen');
+  const anfang = marken.find(e => e.name === 'S:Verwalten')?.ts ?? -Infinity;
+  const ende = marken.find(e => e.name === 'S:Text oeffnen')?.ts ?? Infinity;
+  const layouts = events.filter(e => e.name === 'Layout' && e.ph === 'X' && e.ts >= anfang && e.ts < ende && e.dur >= 40000);
+  assert(layouts.length, 'Großer Layoutdurchlauf fehlt: ' + file);
+  const zeilen = layouts.map(e => {
+    const clicks = events.filter(c => c.name === 'EventDispatch' && c.ph === 'X' && c.args?.data?.type === 'click' && c.pid === e.pid && c.tid === e.tid);
+    const imKlick = clicks.some(c => e.ts >= c.ts && e.ts + e.dur <= c.ts + c.dur);
+    const vorher = clicks.filter(c => c.ts + c.dur <= e.ts).sort((a, b) => b.ts - a.ts)[0];
+    return { ms: rund(e.dur / 1000), dirty: e.args.beginData.dirtyObjects, total: e.args.beginData.totalObjects,
+      imKlick, nachKlickMs: vorher ? rund((e.ts - vorher.ts - vorher.dur) / 1000) : null };
+  });
+  console.log(name + ': ' + JSON.stringify(zeilen));
+  for (const c of events.filter(e => e.name === 'EventDispatch' && e.ph === 'X' && e.args?.data?.type === 'click' && e.ts >= anfang && e.ts < ende)) {
+    const task = events.find(t => t.name === 'RunTask' && t.ph === 'X' && t.pid === c.pid && t.tid === c.tid && t.ts <= c.ts && t.ts + t.dur >= c.ts + c.dur);
+    assert(task, 'Aufgabe des Klick-Handlers fehlt');
+    const eingaben = events.filter(e => e.name === 'EventDispatch' && e.ph === 'X' && e.pid === task.pid && e.tid === task.tid && e.ts >= task.ts && e.ts + e.dur <= task.ts + task.dur);
+    console.log('Klickaufgabe ' + JSON.stringify({ ms: rund(task.dur / 1000),
+      ereignisse: eingaben.map(e => ({ typ: e.args.data.type, ms: rund(e.dur / 1000) })) }));
+  }
+  if (!Array.isArray(input)) {
+    assert.equal(input.identitaet, '2f26be5275dfc14100c34759681047246f942637093fa66e4699d481fb2c2c33', 'End-DOM verändert');
+    assert(input.vor.schriften.length === 2 && input.vor.schriften.every(f => f.status === 'loaded'), 'Schriften nicht geladen');
+  }
+}
