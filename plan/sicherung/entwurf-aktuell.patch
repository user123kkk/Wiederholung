+  }
+  // Nur den geladenen Inhalt ersetzen: Rahmen, Fokus und Rückweg bleiben stehen.
+  const el = document.getElementById("dlg-recht-inhalt");
+  if (ui.dialog === d && el) el.innerHTML = d.html;
