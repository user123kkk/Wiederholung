+/* Tatsächlich ausgesandten SDK-Wrapper prüfen, keine App-Änderung.
+   Feste Gegenprobe: node x_verlauf_batch_ablehnung.js 315bb0e */
+const fs=require('node:fs'),path=require('node:path'),vm=require('node:vm'),assert=require('node:assert/strict'),cp=require('node:child_process');
+const datei='plan/werkzeuge/pruefstand/t_verlauf_mehrgeraete.js';
+const quelle=process.argv[2]?cp.execFileSync('git',['show',process.argv[2]+':'+datei],{encoding:'utf8'}):fs.readFileSync(path.join(__dirname,'t_verlauf_mehrgeraete.js'),'utf8');
+const wrapper=quelle.match(/export function writeBatch\(db\)\{[^\n]+return batch;\}/)?.[0];
+assert.ok(wrapper,'Batch-Ablehnung fehlt im ausgesandten SDK-Wrapper');
+const calls=[];class FieldPath{constructor(name){this.name=name;}}
+const core={FieldPath,writeBatch:()=>({update(ref,...args){calls.push([ref,...args]);return this;},commit(){return 'commit-erhalten';}})};
+const context={core,window:{__PRUEF_ABLEHNEN:true}};vm.createContext(context);
+vm.runInContext(wrapper.replace('export ','')+';globalThis.probe=writeBatch;',context);
+const batch=context.probe({});
+batch.update({path:'users/u1'},new FieldPath('verlauf'),1);
+assert.equal(calls[0].length,5);assert.equal(calls[0][3].name,'__pruef_verboten');assert.equal(calls[0][4],true);
+batch.update({path:'users/u1/karten/k0'},new FieldPath('stufe'),2);assert.equal(calls[1].length,3);
+batch.update({path:'users/u1'},{verlauf:{}});assert.equal(calls[2].length,2);
+context.window.__PRUEF_ABLEHNEN=false;
+batch.update({path:'users/u1'},new FieldPath('verlauf'),1);assert.equal(calls[3].length,3);
+assert.equal(batch.commit(),'commit-erhalten');
+console.log('OK tatsächlicher Batch-Wrapper: verbotener FieldPath nur im Ablehnungsfall, Karten/Maps/normaler Write und Commit erhalten.');
