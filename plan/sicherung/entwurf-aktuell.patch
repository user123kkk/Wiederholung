+const ende = "console.log('App-Zeiten', JSON.stringify(zeiten));";
+if (!quelle.includes(start) || !quelle.includes(ende)) throw new Error('Messanker fehlen');
+quelle = quelle.replace(start, `
+      const events = [];
+      cdp.on('Tracing.dataCollected', d => events.push(...d.value));
+      const fertig = new Promise(r => cdp.once('Tracing.tracingComplete', r));
+      await cdp.send('Profiler.enable'); await cdp.send('Profiler.start');
+      await cdp.send('Tracing.start', { categories: 'devtools.timeline,disabled-by-default-devtools.timeline', transferMode: 'ReportEvents' });
+      ${start}
+      await cdp.send('Tracing.end'); await fertig;
