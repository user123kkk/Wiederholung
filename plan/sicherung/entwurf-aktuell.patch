@@ -0,0 +1,43 @@
+/* Attrappen-Abnahme: unberuehrte Karten nicht erneut lesen, echte Batch-
+   Aenderungen gemeinsam liefern. Feste Gegenprobe: 315bb0e. */
+const vm = require('node:vm'), assert = require('node:assert/strict');
+const { execFileSync } = require('node:child_process');
+const path = require('node:path');
+let source;
+if (process.argv.includes('--gegenprobe')) {
+  const m = { exports: {} };
+  vm.runInNewContext(execFileSync('git', ['show', '315bb0e:plan/werkzeuge/pruefstand/stubs.js'], { cwd: path.join(__dirname, '../../..') }).toString(), { module: m });
+  source = m.exports.FS;
+} else source = require('./stubs').FS;
+let reads = 0;
+const unbewegt = { get wort() { reads++; return 'unberuehrt'; }, wert: 1 };
+const timers = [];
+const window = { __FB: { protokoll: [] }, __START_STORE: { 'users/u/karten/a': unbewegt, 'users/u/karten/b': { wort: 'b', wert: 2 }, 'users/u': { n: 0 } } };
+const context = vm.createContext({ window, console, setTimeout: fn => timers.push(fn) });
+vm.runInContext(source.replace(/export /g, '') + '\nwindow.api={doc,collection,onSnapshot,writeBatch,query,where};', context);
+const f = window.api, db = {};
+const flush = () => { while (timers.length) timers.shift()(); };
+const snaps = [], filtered = [], user = [];
+f.onSnapshot(f.collection(db, 'users/u/karten'), s => snaps.push(s));
+f.onSnapshot(f.query(f.collection(db, 'users/u/karten'), f.where('wert', '==', 9)), s => filtered.push(s));
+f.onSnapshot(f.doc(db, 'users/u'), s => user.push(s));
+flush(); reads = 0;
+(async () => {
+  await f.writeBatch().update(f.doc(db, 'users/u'), { n: 1 }).set(f.doc(db, 'users/u/tagesantworten/x'), { delta: 1 }).commit(); flush();
+  assert.equal(reads, 0, 'Unberuehrte Karte beim Tagesantwort-Batch erneut gelesen');
+  assert.equal(snaps.length, 1); assert.equal(filtered.length, 1); assert.equal(user.length, 2);
+  console.log('OK Tagesantwort meldet nur betroffenes Konto; unberuehrte Karte nullmal gelesen');
+  await f.writeBatch().update(f.doc(db, 'users/u/karten/b'), { wert: 9 }).set(f.doc(db, 'users/u/karten/c'), { wert: 9 }).commit(); flush();
+  assert.equal(snaps.length, 2);
+  assert.equal(snaps[1].docChanges().length, 2);
+  assert.equal(snaps[1].docs.find(d => d.id === 'b').data().wert, 9);
+  assert.equal(snaps[1].docs.find(d => d.id === 'c').data().wert, 9);
+  assert.equal(filtered[1].size, 2);
+  console.log('OK zwei Batch-Aenderungen gemeinsam sichtbar, gefilterte Abfrage ebenfalls aktuell');
+  await f.writeBatch().delete(f.doc(db, 'users/u/karten/b')).delete(f.doc(db, 'users/u/karten/c')).commit(); flush();
+  assert.equal(snaps.length, 3); assert.equal(snaps[2].size, 1);
+  assert.equal(snaps[2].docChanges().length, 2);
+  assert.ok(snaps[2].docChanges().every(d => d.type === 'removed'));
+  assert.equal(filtered[2].size, 0);
+  console.log('OK geloeschte Batch-Dokumente gemeinsam entfernt');
+})().catch(e => { console.error(e); process.exitCode = 1; });
