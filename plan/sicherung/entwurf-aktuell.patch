diff --git a/plan/werkzeuge/projekt_skills.mjs b/plan/werkzeuge/projekt_skills.mjs
new file mode 100644
index 00000000..2ad2ff08
--- /dev/null
+++ b/plan/werkzeuge/projekt_skills.mjs
@@ -0,0 +1,63 @@
+// Gemeinsame Quelle .agents/skills; Claude-Spiegel ohne zusätzliche Abhängigkeiten.
+import fs from 'node:fs';
+import path from 'node:path';
+import assert from 'node:assert/strict';
+import {fileURLToPath} from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const names = ['adrabic-daten', 'adrabic-oberflaeche', 'adrabic-lernbelege', 'llm-council'];
+const args = process.argv.slice(2);
+assert.ok(args.length <= 1 && (!args.length || ['--pruefen', '--schreiben'].includes(args[0])),
+  'Aufruf: node plan/werkzeuge/projekt_skills.mjs [--pruefen|--schreiben]');
+const write = args[0] === '--schreiben';
+const normal = text => text.replace(/\r\n/g, '\n');
+let descChars = 0, bodyBytes = 0;
+
+for (const name of names) {
+  const dir = path.join(root, '.agents/skills', name);
+  const bytes = fs.readFileSync(path.join(dir, 'SKILL.md'));
+  const text = normal(bytes.toString('utf8'));
+  const front = text.match(/^---\nname: ([a-z0-9-]+)\ndescription: ("[^\n]+")\n---\n/);
+  assert.ok(front, `${name}: erwartetes portables YAML fehlt`);
+  assert.equal(front[1], name, `${name}: Ordner und Skillname weichen ab`);
+  const desc = JSON.parse(front[2]); // JSON-String ist zugleich ein YAML-String.
+  assert.ok(desc.length > 0 && desc.length <= 1024, `${name}: Beschreibungslänge`);
+  const body = text.slice(front[0].length);
+  assert.ok(body.length && !body.includes('[TODO'), `${name}: unvollständiger Inhalt`);
+  // Nur als Repo-Pfad geschriebene Referenzen, keine Befehle/Abschnittsnummern.
+  for (const match of body.matchAll(/`((?:plan\/|\.agents\/|\.claude\/|splash\/)[^`\n]+)`/g)) {
+    assert.ok(fs.existsSync(path.join(root, match[1])), `${name}: Verweis fehlt: ${match[1]}`);
+  }
+  const yaml = normal(fs.readFileSync(path.join(dir, 'agents/openai.yaml'), 'utf8'));
+  assert.match(yaml, /allow_implicit_invocation: true/, `${name}: automatische Auswahl fehlt`);
+  const short = yaml.match(/short_description: ("[^\n]+")/);
+  assert.ok(short && JSON.parse(short[1]).length >= 25 && JSON.parse(short[1]).length <= 64,
+    `${name}: Kurzbeschreibung muss 25–64 Zeichen haben`);
+  assert.ok(yaml.includes(`$${name}`), `${name}: Standardprompt nennt Skill nicht`);
+  const mirror = path.join(root, '.claude/skills', name, 'SKILL.md');
+  if (write) {
+    fs.mkdirSync(path.dirname(mirror), {recursive: true});
+    // Ausschließlich die oben genannten verwalteten Spiegel; keine fremden Skills ändern.
+    fs.writeFileSync(mirror, bytes);
+  }
+  assert.ok(fs.existsSync(mirror), `${name}: Claude-Spiegel fehlt; --schreiben ausführen`);
+  assert.equal(normal(fs.readFileSync(mirror, 'utf8')), text,
+    `${name}: Claude-Spiegel veraltet; Quelle ändern, dann --schreiben`);
+  if (name === 'llm-council') {
+    for (const rel of ['README.md', 'references/upstream-SKILL.md']) {
+      const source = path.join(dir, rel);
+      const target = path.join(root, '.claude/skills', name, rel);
+      if (write) {
+        fs.mkdirSync(path.dirname(target), {recursive: true});
+        fs.copyFileSync(source, target);
+      }
+      assert.equal(normal(fs.readFileSync(target, 'utf8')), normal(fs.readFileSync(source, 'utf8')),
+        `${name}: Quellennachweis-Spiegel veraltet: ${rel}`);
+    }
+  }
+  descChars += desc.length;
+  bodyBytes += Buffer.byteLength(body, 'utf8');
+  console.log(`OK ${name}: portable Metadaten, Repo-Verweise, automatische Auswahl erlaubt, Spiegel identisch`);
+}
+console.log(`${names.length} Skills; Beschreibungen ${descChars} Zeichen; Inhalte ${bodyBytes} UTF-8-Bytes.`);
+console.log('Dies prüft Dateien und Konfiguration, nicht die Auswahlentscheidung eines laufenden Modells.');
